% =====================================================================
%  wktemplates.sty  —  WK-UNIVERSE page scaffolding (fonts, bg, footer)
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{wktemplates}[2026/06/14 WK-UNIVERSE templates]
\RequirePackage{eso-pic}
\RequirePackage{fancyhdr}

% ---- font shortcuts -------------------------------------------------
\newcommand{\displayfont}{\sffamily\bfseries}
\newcommand{\monofont}{\ttfamily}
\newcommand{\hugetitle}[1]{{\displayfont\fontsize{60}{64}\selectfont #1}}
\newcommand{\bigtitle}[1]{{\displayfont\fontsize{40}{44}\selectfont #1}}

% ---- background motif behind everything (pass a motif macro call) ---
\newcommand{\wkbg}[1]{\AddToShipoutPictureBG{#1}}

% ---- footer line ----------------------------------------------------
\newcommand{\wkfooter}[3]{%
  \pagestyle{fancy}\fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}%
  \fancyfoot[L]{\scriptsize\textcolor{FogGray}{#1}}%
  \fancyfoot[C]{\scriptsize\textcolor{FogGray}{#2}}%
  \fancyfoot[R]{\scriptsize\textcolor{FogGray}{#3}}%
}

% ---- full-width colour band (use inside the body) -------------------
% \wkband{height}{bgcolor}{inner content (already coloured)}
\newcommand{\wkband}[3]{%
  \noindent\colorbox{#2}{\begin{minipage}[c][#1][c]{\linewidth}%
    \centering #3\end{minipage}}%
}

\endinput
