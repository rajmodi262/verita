# Verita backend configuration — all optional. Copy to .env and edit as needed.
# The app runs fully with NONE of these set (zero-config demo).

# ── CORS (comma-separated origins for the Vite dev server) ──
VERITA_CORS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000

# ── Upload guardrails ──
VERITA_MAX_UPLOAD_MB=25
VERITA_MAX_ROWS=200000

# ── Security (opt-in) ──
# If set, every /api/* request (except /api/health) must send a matching X-API-Key header.
# VERITA_API_KEY=change-me
VERITA_RATE_LIMIT=600          # requests per window per IP
VERITA_RATE_WINDOW=60          # window seconds

# ── GenAI (opt-in) — enhances the executive summary, NL->SQL, and the investigator memo ──
# Without a key, Verita uses its deterministic rule-based engines (fully functional).
# Provider precedence: Groq (primary) -> Gemini (fallback) -> rule-based.
#
# Groq (OpenAI-compatible, fast) — get a key at https://console.groq.com/keys
# GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile
#
# Google Gemini (fallback) — get a key at https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash
